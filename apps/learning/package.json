{
  "name": "@fushi/learning",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm copy:dictionary && vite",
    "build": "pnpm copy:dictionary && tsc -p tsconfig.json --noEmit && pnpm test:content && vite build",
    "preview": "node server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:content && vitest run",
    "test:content": "tsx scripts/check-content.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "copy:dictionary": "node ../../scripts/copy-dictionary.mjs"
  },
  "dependencies": {
    "@callieniera/fushi": "workspace:@callieniera/fushi@*"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.59.0"
  }
}
